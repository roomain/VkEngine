<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />  
  <PropertyGroup Label="UserMacros">
    <CRC_DIR>$(SolutionDir)thirdparty\sources\install_crc32c</CRC_DIR>
    <CRC_INC>$(CRC_DIR)\$(Configuration)\include</CRC_INC>
    <CRC_BIN>$(CRC_DIR)\$(Configuration)\bin</CRC_BIN>
    <CRC_LIB>$(CRC_DIR)\$(Configuration)\lib</CRC_LIB>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(CRC_INC);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(CRC_LIB);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>crc32c.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command></Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="CRC_DIR">
      <Value>$(CRC_DIR)</Value>
    </BuildMacro>
    <BuildMacro Include="CRC_INC">
      <Value>$(CRC_INC)</Value>
    </BuildMacro>
    <BuildMacro Include="CRC_LIB">
      <Value>$(CRC_LIB)</Value>
    </BuildMacro>
    <BuildMacro Include="CRC_BIN">
      <Value>$(CRC_BIN)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>